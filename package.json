{
  "name": "exam-pilot",
  "version": "1.0.0",
  "private": true,
  "description": "Exam Pilot — unified exam preparation + exam analysis platform (local-first).",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "build:single": "vite build --config vite.single.config.mts",
    "test:e2e": "npm run build:single && vitest run --config vitest.e2e.config.mts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "pdf-lib": "^1.17.1",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.2"
  }
}
